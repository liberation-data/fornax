+// disables the split. Unset, the split is on only over Vulkan: it is there for amdgpu's 2 s job timeout, and elsewhere
+// it would only change kernel choices and cost peak memory.
+static double sd_chunk_budget(const char* var, double vulkan_default, ggml_backend_t backend) {
+    const char* env = std::getenv(var);
+    if (env == nullptr) {
