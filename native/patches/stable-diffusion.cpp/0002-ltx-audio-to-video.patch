+    // waveform: [samples, channels] at config.sample_rate. Returns [mel_bins, 1 + samples / hop, channels, 1].
+    static sd::Tensor<float> ltx_log_mel(const sd::Tensor<float>& waveform, const LTXAudioVAEConfig& config) {
+        const int64_t samples = waveform.shape()[0], channels = waveform.shape()[1];
+        const int n_fft = config.n_fft, hop = config.mel_hop_length, half = n_fft / 2, n_freqs = n_fft / 2 + 1;
+        GGML_ASSERT((n_fft & (n_fft - 1)) == 0);
+        if (samples <= half)
+            throw std::runtime_error("reference audio is too short for the LTX audio VAE");
+        const int64_t frames = 1 + samples / hop;
+        const auto filters   = ltx_mel_filters(config.sample_rate, n_fft, config.mel_bins);
+        std::vector<double> window(static_cast<size_t>(n_fft));
+        for (int i = 0; i < n_fft; ++i)
+            window[static_cast<size_t>(i)] = 0.5 - 0.5 * std::cos(2.0 * 3.14159265358979323846 * i / n_fft);
+        sd::Tensor<float> mel({config.mel_bins, frames, channels, 1});
+        std::vector<double> re(static_cast<size_t>(n_fft)), im(static_cast<size_t>(n_fft)), magnitude(static_cast<size_t>(n_freqs));
