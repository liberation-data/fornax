+    }
+
+    static double ltx_mel_to_hz(double mel) {
+        return mel >= 15.0 ? 1000.0 * std::exp((std::log(6.4) / 27.0) * (mel - 15.0)) : (200.0 / 3.0) * mel;
+    }
