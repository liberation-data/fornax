index 2226d3a..693a7ac 100644
--- a/src/dgl/ops/media.cpp
+++ b/src/dgl/ops/media.cpp
@@ -4,6 +4,7 @@
 #include <cmath>
 #include <cstdlib>
 #include <cstring>
+#include <numeric>
 
 #include "conditioning/wan_audio.h"
 #include "dgl/models/audio_vae.h"
@@ -158,6 +159,60 @@ namespace sd::dgl::ops {
         return waveform;
     }
 
+    // Band-limited resampling as torchaudio's (and ComfyUI's) sinc_interp_hann: lowpass_filter_width 6, rolloff 0.99,
+    // zero padding, ceil(new * length / orig) samples out. Returns planar [samples, channels] (one or two channels),
+    // the layout LTXAudioVAERunner::encode takes.
+    sd::Tensor<float> prepare_ltx_reference_waveform(const sd::Audio& audio,
+                                                     int target_sample_rate) {
+        if (audio.data == nullptr || audio.sample_count == 0 || audio.channels == 0 || audio.sample_rate == 0 || target_sample_rate <= 0) {
+            return {};
+        }
+        const int64_t channels = std::min<int64_t>(audio.channels, 2);
+        const int64_t length   = static_cast<int64_t>(audio.sample_count);
+        if (static_cast<int>(audio.sample_rate) == target_sample_rate) {
+            sd::Tensor<float> waveform({length, channels});
+            for (int64_t c = 0; c < channels; ++c)
+                for (int64_t i = 0; i < length; ++i)
+                    waveform.index(i, c) = audio.data[i * audio.channels + c];
+            return waveform;
+        }
+        constexpr double kPi           = 3.14159265358979323846;
+        constexpr int filter_width     = 6;
+        constexpr double rolloff       = 0.99;
+        const int64_t divisor          = std::gcd(static_cast<int64_t>(audio.sample_rate), static_cast<int64_t>(target_sample_rate));
+        const int64_t orig             = audio.sample_rate / divisor;
+        const int64_t next             = target_sample_rate / divisor;
+        const double base              = std::min(orig, next) * rolloff;
+        const int64_t width            = static_cast<int64_t>(std::ceil(filter_width * orig / base));
+        const int64_t taps             = 2 * width + orig;
+        std::vector<double> kernel(static_cast<size_t>(next * taps));
+        for (int64_t phase = 0; phase < next; ++phase) {
+            for (int64_t k = 0; k < taps; ++k) {
+                double t      = (-static_cast<double>(phase) / next + static_cast<double>(k - width) / orig) * base;
+                t             = std::clamp(t, -static_cast<double>(filter_width), static_cast<double>(filter_width));
+                double window = std::cos(t * kPi / filter_width / 2);
+                window *= window;
+                t *= kPi;
+                kernel[static_cast<size_t>(phase * taps + k)] = (t == 0 ? 1.0 : std::sin(t) / t) * window * (base / orig);
+            }
+        }
+        const int64_t out_length = static_cast<int64_t>(std::ceil(static_cast<float>(next * length) / static_cast<float>(orig)));
+        sd::Tensor<float> waveform({out_length, channels});
+        for (int64_t c = 0; c < channels; ++c) {
+            for (int64_t i = 0; i < out_length; ++i) {
+                const int64_t frame = i / next, phase = i % next;
+                double sum          = 0.0;
+                for (int64_t k = 0; k < taps; ++k) {
+                    const int64_t source = frame * orig + k - width;
+                    if (source >= 0 && source < length)
+                        sum += audio.data[source * audio.channels + c] * kernel[static_cast<size_t>(phase * taps + k)];
+                }
+                waveform.index(i, c) = static_cast<float>(sum);
+            }
+        }
+        return waveform;
+    }
