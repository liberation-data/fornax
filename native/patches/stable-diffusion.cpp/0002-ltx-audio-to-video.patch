+    // The audio stream's share of the noise level: the largest denoise-mask value over the packed audio channels
+    // (those after the video's), so audio held fixed (mask 0, e.g. a soundtrack to animate to) gets timestep 0.
+    static float ltxav_audio_mask_scale(const sd::Tensor<float>& denoise_mask, int64_t video_channels) {
+        if (denoise_mask.dim() < 4 || denoise_mask.shape()[3] <= video_channels)
+            return 1.f;
+        const auto& s       = denoise_mask.shape();
+        const int64_t plane = s[0] * s[1] * s[2];
+        const int64_t outer = denoise_mask.numel() / (plane * s[3]);
+        float scale         = 0.f;
+        for (int64_t o = 0; o < outer; ++o)
+            for (int64_t c = video_channels; c < s[3]; ++c) {
+                const float* values = denoise_mask.data() + (o * s[3] + c) * plane;
+                scale               = std::max(scale, *std::max_element(values, values + plane));
+            }
+        return scale;
+    }
