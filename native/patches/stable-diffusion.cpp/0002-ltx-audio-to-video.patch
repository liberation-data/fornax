+    // [n_freqs][n_mels] Slaney-scale triangles with Slaney area normalization, from 0 Hz to sample_rate / 2.
+    static std::vector<double> ltx_mel_filters(int sample_rate, int n_fft, int n_mels) {
+        const int n_freqs = n_fft / 2 + 1;
+        const double top  = ltx_hz_to_mel(sample_rate / 2.0);
+        std::vector<double> points(static_cast<size_t>(n_mels + 2));
+        for (int i = 0; i < n_mels + 2; ++i)
+            points[static_cast<size_t>(i)] = ltx_mel_to_hz(top * i / (n_mels + 1));
+        std::vector<double> filters(static_cast<size_t>(n_freqs * n_mels), 0.0);
+        for (int f = 0; f < n_freqs; ++f) {
+            const double hz = static_cast<double>(sample_rate / 2) * f / (n_freqs - 1);
+            for (int m = 0; m < n_mels; ++m) {
+                const double lo = points[m], mid = points[m + 1], hi = points[m + 2];
+                const double up = (hz - lo) / (mid - lo), down = (hi - hz) / (hi - mid);
+                filters[static_cast<size_t>(f * n_mels + m)] = std::max(0.0, std::min(up, down)) * 2.0 / (hi - lo);
+            }
+        }
+        return filters;
+    }
