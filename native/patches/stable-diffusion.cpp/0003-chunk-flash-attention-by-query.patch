--- a/src/core/ggml_extend.cpp
+++ b/src/core/ggml_extend.cpp
@@ -1,6 +1,8 @@
 #include "core/ggml_extend.h"
 
+#include <algorithm>
 #include <cmath>
+#include <cstdlib>
 #include <stdexcept>
 #include <utility>
 #include <vector>
@@ -593,6 +595,17 @@ ggml_tensor* ggml_ext_cast_f32(GGMLRunnerContext* runner_ctx, ggml_tensor* a) {
     }
 }
 
+// FLOP budget for one flash-attention node; longer attentions are split by query rows. 1e12 is about 0.2 s on a
+// Radeon 8060S over Vulkan (~5 TFLOPS), well inside amdgpu's 2 s job timeout. SD_FA_CHUNK_FLOPS overrides it (0 disables
+// the split).
+static double sd_fa_chunk_flops() {
+    static const double budget = [] {
+        const char* env = std::getenv("SD_FA_CHUNK_FLOPS");
+        return env != nullptr ? std::strtod(env, nullptr) : 1e12;
+    }();
+    return budget;
+}
+
 ggml_tensor* ggml_ext_attention_ext(GGMLRunnerContext* runner_ctx,
                                     ggml_tensor* q,
                                     ggml_tensor* k,
@@ -690,11 +703,37 @@ ggml_tensor* ggml_ext_attention_ext(GGMLRunnerContext* runner_ctx,
             mask_in = ggml_cast(ctx, mask_in, GGML_TYPE_F16);
         }
 
-        auto out = ggml_flash_attn_ext(ctx, q_in, k_in, v_in, mask_in, scale / kv_scale, 0, 0);
-        if (!ggml_backend_supports_op(backend, out)) {
-            return nullptr;
+        // A backend may run one FA node as a single GPU dispatch, and a long one outlasts driver watchdogs (amdgpu's
+        // 2 s job timeout lost the device on a 47k-token LTX video self-attention over Vulkan). Split the queries into
+        // row chunks of at most sd_fa_chunk_flops() each, every chunk its own node; the chunks share K and V. A mask is
+        // sliced with them when its rows stay contiguous (one mask shared by all heads and batches); any other mask
+        // keeps the single node. No expand_graph per chunk: the outputs live until the concat anyway, and the
+        // reordering cost LTX ~5% per step on Vulkan.
+        const double fa_flops = 2.0 * q_in->ne[1] * q_in->ne[2] * q_in->ne[3] * (k_in->ne[0] + v_in->ne[0]) * k_in->ne[1];
+        const double budget   = sd_fa_chunk_flops();
+        const bool sliceable  = mask_in == nullptr || (mask_in->ne[2] == 1 && mask_in->ne[3] == 1);
+        int64_t rows          = q_in->ne[1];
+        if (sliceable && budget > 0 && fa_flops > budget) {
+            const int64_t n_chunks = static_cast<int64_t>(std::ceil(fa_flops / budget));
+            rows                   = GGML_PAD((q_in->ne[1] + n_chunks - 1) / n_chunks, 64);
+        }
+        std::vector<ggml_tensor*> outs;
+        for (int64_t start = 0; start < q_in->ne[1]; start += rows) {
+            const int64_t n = std::min(rows, q_in->ne[1] - start);
+            auto q_rows     = n == q_in->ne[1] ? q_in
+                                               : ggml_view_4d(ctx, q_in, q_in->ne[0], n, q_in->ne[2], q_in->ne[3], q_in->nb[1],
+                                                              q_in->nb[2], q_in->nb[3], start * q_in->nb[1]);
+            auto mask_rows  = mask_in == nullptr || n == q_in->ne[1]
+                                  ? mask_in
+                                  : ggml_view_2d(ctx, mask_in, mask_in->ne[0], n, mask_in->nb[1], start * mask_in->nb[1]);
+            auto part       = ggml_flash_attn_ext(ctx, q_rows, k_in, v_in, mask_rows, scale / kv_scale, 0, 0);
+            if (!ggml_backend_supports_op(backend, part)) {
+                return nullptr;
+            }
+            ggml_prec_set_acc(part, GGML_PREC_F32);
+            outs.push_back(part);
         }
-        ggml_prec_set_acc(out, GGML_PREC_F32);
+        auto out = ggml_ext_vec_concat(runner_ctx, outs, 2);
         if (kv_scale != 1.0f) {
             out = ggml_ext_scale(runner_ctx, out, 1.0f / kv_scale);
         }
