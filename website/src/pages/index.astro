        <script>
            // The GitHub menu closes on a click outside it or Escape, as a menu should.
            for (const menu of document.querySelectorAll<HTMLDetailsElement>('.repo-menu')) {
                document.addEventListener('click', (e) => { if (menu.open && !menu.contains(e.target as Node)) menu.open = false; });
                document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && menu.open) { menu.open = false; menu.querySelector('summary')?.focus(); } });
            }
        </script>
        <script>
            // The dark section's fire: scrolling steps through its frames (a crackle every ~40 px) and drifts it slower
            // than the page. Left on its first frame for reduced motion and on phones.
            {
                const flames = document.querySelector<HTMLElement>('.dark .flames');
                const still = matchMedia('(prefers-reduced-motion: reduce), (max-width: 800px)');
                if (flames) {
                    const frames = [...flames.querySelectorAll('img')];
                    let shown = 0, queued = false;
                    const show = (k: number) => { if (k !== shown) { frames[shown].classList.remove('on'); frames[k].classList.add('on'); shown = k; } };
                    const update = () => {
                        queued = false;
                        // Turned still since (a narrower window, reduced motion switched on): back to the first frame, unmoved.
                        if (still.matches) { show(0); for (const f of frames) f.style.transform = ''; return; }
                        const box = flames.getBoundingClientRect();
                        if (box.bottom < 0 || box.top > innerHeight) return;
                        show(Math.floor(scrollY / 40) % frames.length);
                        const drift = (box.top + box.height / 2 - innerHeight / 2) * -0.2;
                        for (const f of frames) f.style.transform = `translateY(${drift.toFixed(1)}px)`;
                    };
                    const queue = () => { if (!queued) { queued = true; requestAnimationFrame(update); } };
                    addEventListener('scroll', queue, { passive: true });
                    addEventListener('resize', queue);
                    still.addEventListener('change', () => { if (!still.matches) for (const f of frames) f.loading = 'eager'; queue(); });
                    if (!still.matches) for (const f of frames) f.loading = 'eager';
                    update();
                }
            }
        </script>
