        <script>
            // The explainer's player, as on drivine.org and the Embabel Worlds page. The video loads only when asked for, and
            // plays with its controls and its captions, on from the start (the CC button turns them off). It plays from its
            // HLS segments where there are some: Safari plays the playlist itself, other browsers through hls.js (its light
            // build, fetched once the page has loaded, so a press doesn't wait for it). Where neither can, or hls.js fails,
            // the whole mp4 plays; where that fails too, the poster says so. At the end the logo the video holds goes back
            // over it, with Watch again and Share.
            let hlsJs: Promise<typeof import('hls.js/light').default | undefined> | undefined;
            const loadHls = () => (hlsJs ??= import('hls.js/light').then((it) => (it.default.isSupported() ? it.default : undefined), () => undefined));
            const nativeHls = (video: HTMLVideoElement) => video.canPlayType('application/vnd.apple.mpegurl') !== '';
            const unplayable = (player: HTMLElement) => {
                const note = document.createElement('p');
                note.className = 'unplayable';
                note.setAttribute('role', 'status');
                note.textContent = "This browser can't play the video.";
                player.querySelector('video')?.remove();
                player.querySelector('.play')?.remove();
                player.append(note);
            };
            const source = (video: HTMLVideoElement, player: HTMLElement) => {
                const { hls, video: mp4 } = player.dataset;
                // hls.js, while it has the video.
                let through: { destroy(): void } | undefined;
                let fellBack = false;
                // The mp4, once: after it, nothing is left to try.
                const fallback = () => {
                    through?.destroy();
                    through = undefined;
                    if (fellBack || !mp4) return unplayable(player);
                    fellBack = true;
                    video.src = mp4;
                    void video.play().catch(() => {});
                };
                // Added before the poster's own listeners, it keeps each error from them, so the poster waits for a frame
                // that plays, or says nothing would.
                video.addEventListener('error', (event) => {
                    event.stopImmediatePropagation();
                    if (video.error) fallback();
                });
                if (!hls) return fallback();
                if (nativeHls(video)) {
                    video.src = hls;
                    return;
                }
                void loadHls().then((Hls) => {
                    if (!Hls) return fallback();
                    const it = new Hls();
                    through = it;
                    it.on(Hls.Events.ERROR, (_, data) => data.fatal && through === it && fallback());
                    it.loadSource(hls);
                    it.attachMedia(video);
                    void video.play().catch(() => {});
                });
            };
            const playVideo = () => {
                const player = document.querySelector<HTMLElement>('.explainer .player');
                // Once it has said it can't play, the hero's pill doesn't try again.
                if (!player || player.querySelector('.unplayable')) return;
                // Started by the hero's pill, the poster's own listener is still waiting.
                player.removeEventListener('click', playVideo);
                const video = document.createElement('video');
                source(video, player);
                video.controls = true;
                video.autoplay = true;
                video.playsInline = true;
                video.preload = 'auto';
                video.setAttribute('aria-label', player.dataset.title!);
                if (player.dataset.captions) {
                    const captions = document.createElement('track');
                    captions.kind = 'captions';
                    captions.src = player.dataset.captions;
                    captions.srclang = 'en';
                    captions.label = 'English';
                    captions.default = true;
                    video.append(captions);
                }
                const endFrame = document.querySelector<HTMLTemplateElement>('#video-end')?.content.firstElementChild;
                const end = endFrame ? (document.importNode(endFrame, true) as HTMLElement) : undefined;
                const ending = document.querySelector<HTMLElement>('.ending-share');
                const endingHome = ending?.parentElement;
                const again = document.createElement('button');
                again.type = 'button';
                again.className = 'play again';
                again.setAttribute('aria-label', `Watch again: ${player.dataset.title}`);
                again.innerHTML = '<span><svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z" fill="currentColor" /></svg>Watch again</span>';
                again.addEventListener('click', () => {
                    video.currentTime = 0;
                    void video.play();
                    video.focus({ preventScroll: true });
                });
                video.addEventListener('ended', () => {
                    // The focus, if it was on the video, goes to the button rather than staying on a finished video.
                    const focused = document.activeElement === video;
                    if (end) player.append(end);
                    player.append(again);
                    if (ending) player.append(ending);
                    if (focused) again.focus({ preventScroll: true });
                });
                video.addEventListener('play', () => {
                    end?.remove();
                    again.remove();
                    if (ending && endingHome) endingHome.append(ending);
                });
                // Until its first frame is in, the poster stays and its button says Loading: started cold, a browser shows
                // only a grey box. aria-disabled rather than disabled, so the focus stays on it and a screen reader hears it.
                const button = player.querySelector<HTMLButtonElement>('.play');
                const label = button?.querySelector('span');
                if (button && label) {
                    button.setAttribute('aria-disabled', 'true');
                    button.removeAttribute('aria-label');
                    label.replaceChildren(label.querySelector('svg')!, 'Loading…');
                }
                let shown = false;
                const show = () => {
                    if (shown) return;
                    shown = true;
                    player.replaceChildren(video);
                    video.focus({ preventScroll: true });
                };
                for (const event of ['loadeddata', 'playing']) video.addEventListener(event, show, { once: true });
                player.prepend(video);
                // Played from the press itself, which Safari asks of a video with sound. Through hls.js the video has no
                // source yet, so this play is interrupted (AbortError) and played again once it has one; a source that
                // fails (NotSupportedError) has the mp4 tried. Anything else (autoplay blocked): its own controls show.
                video.play().catch((error) => !['AbortError', 'NotSupportedError'].includes(error.name) && show());
            };
            document.querySelector('.explainer .player')?.addEventListener('click', playVideo, { once: true });
            // The hero's pill takes the visitor down to the video and plays it from the start.
            document.querySelector<HTMLAnchorElement>('.video-tip')?.addEventListener('click', (event) => {
                if (!document.querySelector('.explainer .player')) return;
                event.preventDefault();
                const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
                document.getElementById('video')?.scrollIntoView({ behavior: still ? 'auto' : 'smooth' });
                history.replaceState(null, '', '#video');
                const video = document.querySelector<HTMLVideoElement>('.explainer video');
                if (!video) return playVideo();
                video.currentTime = 0;
                void video.play();
            });
            // Once the page has loaded: the playlist and its header (a few hundred bytes each), and hls.js where it will
            // play, so a press doesn't wait for them. The segments are left until then.
            addEventListener('load', () => {
                const hls = document.querySelector<HTMLElement>('.explainer .player')?.dataset.hls;
                if (!hls) return;
                for (const file of ['index.m3u8', 'init.mp4']) void fetch(new URL(file, new URL(hls, location.href))).catch(() => {});
                if (!nativeHls(document.createElement('video'))) void loadHls();
            });
        </script>
    </body>
</html>
