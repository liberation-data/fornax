---
/**
 * One group of the Benchmarks page from src/data/benchmarks.json: each runner's figures in a table, and under it the
 * command behind every row, so a figure can be checked by running what produced it.
 */
import data from '../../data/benchmarks.json';

interface Props { id: string }
const group = data.groups.find((g) => g.id === Astro.props.id);
if (!group) throw new Error(`no benchmark group ${Astro.props.id}`);
---
<p>{group.note}</p>
<table>
    <thead>
        <tr><th>Runner</th><th>Engine</th>{group.columns.map((c) => <th>{c}</th>)}</tr>
    </thead>
    <tbody>
        {group.rows.map((r) => (
            <tr><td><strong>{r.runner}</strong></td><td>{r.engine}</td>{r.values.map((v) => <td class="figure">{v}</td>)}</tr>
        ))}
    </tbody>
</table>
<details>
    <summary>Commands behind these rows</summary>
    <ul>
        {group.rows.map((r) => <li><strong>{r.runner}</strong>: <code>{r.command}</code></li>)}
    </ul>
</details>

<style>
    .figure { white-space: nowrap; }
</style>
